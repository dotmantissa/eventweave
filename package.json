{
  "name": "eventweave",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.22 <23"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "npm run build:packages && concurrently -n api,web 'npm run dev -w @eventweave/api' 'npm run dev -w @eventweave/web'",
    "build:packages": "node scripts/build-packages.mjs",
    "build": "npm run build:packages && npm run build -w @eventweave/web && npm run typecheck",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && python3 scripts/contracts.py --check",
    "pretest": "npm run build:packages",
    "test": "vitest run && python3 -m pytest tests/direct tests/validator -q",
    "deploy:contracts": "tsx scripts/deploy.ts",
    "network:verify": "tsx scripts/network-verify.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "worker": "tsx apps/api/src/worker.ts",
    "schemas": "tsx scripts/export-schemas.ts",
    "verify:signed": "tsx scripts/signed-client-verify.ts",
    "format:check": "prettier --check apps packages api scripts/*.ts scripts/*.mjs tests/*.ts *.json *.js *.yaml"
  },
  "dependencies": {
    "dotenv": "17.2.3",
    "genlayer-js": "1.1.8",
    "viem": "2.57.18"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.56.1",
    "@types/node": "22.19.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "9.2.5",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.5.0",
    "node": "22.22.0",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vite": "6.4.6",
    "vitest": "4.1.12"
  }
}
